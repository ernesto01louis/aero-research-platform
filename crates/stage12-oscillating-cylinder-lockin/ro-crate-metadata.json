    {
      "@id": "#limitation-container-digest-by-lookup",
      "@type": "CreativeWork",
      "isBasedOn": "aero/provenance/four_fold.py",
      "name": "container-digest-by-lookup",
      "text": "container_sif_sha256 is looked up by SIF basename in containers/SHA256SUMS at run time; the SIF that actually ran was not re-hashed (review item P1c)."
    },
    {
      "@id": "#limitation-dvc-input-hash-sync-state",
      "@type": "CreativeWork",
      "isBasedOn": "aero/provenance/four_fold.py",
      "name": "dvc-input-hash-sync-state",
      "text": "dvc_input_hash is the sha256 of the DVC remote sync state (`dvc status -c`), not a content address of the inputs: one constant value appears across all 74 occurrences in data/vv. It shows the inputs were in sync with the remote at run time; it does not identify them."
    },
    {
      "@id": "#limitation-input-uq-skipped",
      "@type": "CreativeWork",
      "isBasedOn": "aero/vv/reportable.py",
      "name": "input-uq-skipped",
      "text": "No input (parametric) uncertainty quantification was performed: u95_input is 0 with basis 'skipped', so U95 here is numerical (+ statistical where stated) only."
    },
    {
      "@id": "#limitation-uq-reference-outside-release-narrative",
      "@type": "CreativeWork",
      "isBasedOn": "docs/handoffs/STAGE-12-vv-uq-core-DONE-2026-07-05.md",
      "name": "uq-reference-outside-release-narrative",
      "text": "A U95-machinery reference, not part of the optimizer demonstration: the only thesis-grade record committed, carrying both a numerical (GCI) and a statistical (batch-means) U95 term and a passing experiment anchor."
    },
