      "@id": "#limitation-container-digest-by-lookup",
      "@type": "CreativeWork",
      "isBasedOn": "aero/provenance/four_fold.py",
      "name": "container-digest-by-lookup",
      "text": "container_sif_sha256 is looked up by SIF basename in containers/SHA256SUMS at run time; the SIF that actually ran was not re-hashed (review item P1c)."
    },
    {
      "@id": "#limitation-diagnostic-not-gate",
      "@type": "CreativeWork",
      "isBasedOn": "data/vv/stage15_optimization.json",
      "name": "diagnostic-not-gate",
      "text": "Only 'delta-exceeds-k-u95' decided the Stage-15 verdict. The other gates are reported diagnostics."
    },
    {
      "@id": "#limitation-dvc-input-hash-sync-state",
      "@type": "CreativeWork",
      "isBasedOn": "aero/provenance/four_fold.py",
      "name": "dvc-input-hash-sync-state",
      "text": "dvc_input_hash is the sha256 of the DVC remote sync state (`dvc status -c`), not a content address of the inputs: one constant value appears across all 74 occurrences in data/vv. It shows the inputs were in sync with the remote at run time; it does not identify them."
    },
    {
      "@id": "#limitation-input-uq-skipped",
      "@type": "CreativeWork",
      "isBasedOn": "aero/vv/reportable.py",
      "name": "input-uq-skipped",
      "text": "No input (parametric) uncertainty quantification was performed: u95_input is 0 with basis 'skipped', so U95 here is numerical (+ statistical where stated) only."
    },
    {
      "@id": "#limitation-no-experiment-anchor",
      "@type": "CreativeWork",
      "isBasedOn": "data/vv/stage15_optimization.json",
      "name": "no-experiment-anchor",
      "text": "The airfoil objective's forward model (k-omega SST, wall functions, Re 5e5) has no experiment anchor: anchors = [] in the record. Improvements are matched-condition CFD deltas, not validated absolute values."
    },
    {
      "@id": "#limitation-nogo",
      "@type": "CreativeWork",
      "isBasedOn": "data/vv/stage15_optimization.json",
      "name": "nogo",
      "text": "NO-GO: the optimum's matched delta 24.66 did NOT exceed even its own U95 of 25.37 (the gated bar is 2 x U95 = 50.75). The family is not grid-converged (observed order -1.10). The +113.8 % baseline-to-optimum change is NOT an improvement claim."
    },
    {
      "@id": "#limitation-not-flagship-domain",
      "@type": "CreativeWork",
      "isBasedOn": "docs/adrs/ADR-046-stage-21-rescope-release-first.md",
      "name": "not-flagship-domain",
      "text": "This optimization is on the AIRFOIL case. The optimizer has never been run on a flapping-wing case. No flapping optimization claim is made in v0.1.0."
    },
    {
      "@id": "#limitation-retracted-claim",
      "@type": "CreativeWork",
      "isBasedOn": "CHANGELOG.md",
      "name": "retracted-claim",
      "text": "An earlier draft claimed a '+47 % thesis-grade CFD-verified improvement'. It was withdrawn after an adversarial audit and a 3-grid observed-order V&V refuted it."
    },
