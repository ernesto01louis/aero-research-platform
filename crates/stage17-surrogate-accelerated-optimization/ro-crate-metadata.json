    },
    {
      "@id": "#limitation-container-digest-by-lookup",
      "@type": "CreativeWork",
      "isBasedOn": "aero/provenance/four_fold.py",
      "name": "container-digest-by-lookup",
      "text": "container_sif_sha256 is looked up by SIF basename in containers/SHA256SUMS at run time; the SIF that actually ran was not re-hashed (review item P1c)."
    },
    {
      "@id": "#limitation-diagnostic-not-gate",
      "@type": "CreativeWork",
      "isBasedOn": "data/vv/stage17_optimization.json",
      "name": "diagnostic-not-gate",
      "text": "Gates marked gated decided the verdicts. The rest are reported diagnostics, including the margin over the corpus best and the proposer's certificate."
    },
    {
      "@id": "#limitation-dvc-input-hash-sync-state",
      "@type": "CreativeWork",
      "isBasedOn": "aero/provenance/four_fold.py",
      "name": "dvc-input-hash-sync-state",
      "text": "dvc_input_hash is the sha256 of the DVC remote sync state (`dvc status -c`), not a content address of the inputs: one constant value appears across all 74 occurrences in data/vv. It shows the inputs were in sync with the remote at run time; it does not identify them."
    },
    {
      "@id": "#limitation-held-out-is-same-grid-re-solve",
      "@type": "CreativeWork",
      "isBasedOn": "data/vv/stage17_speedup.json",
      "name": "held-out-is-same-grid-re-solve",
      "text": "'Held out' means a deterministic same-grid re-solve that reproduces the loop's value bit for bit. It re-confirms the value; it adds no resolution."
    },
    {
      "@id": "#limitation-input-uq-skipped",
      "@type": "CreativeWork",
      "isBasedOn": "aero/vv/reportable.py",
      "name": "input-uq-skipped",
      "text": "No input (parametric) uncertainty quantification was performed: u95_input is 0 with basis 'skipped', so U95 here is numerical (+ statistical where stated) only."
    },
    {
      "@id": "#limitation-margin-inside-u95",
      "@type": "CreativeWork",
      "isBasedOn": "data/vv/stage17_optimization.json",
      "name": "margin-inside-u95",
      "text": "46.372 exceeds the corpus best 46.337 by 0.035, far inside the quantity's U95 of 7.03, and is not claimed. The claim that clears 2 x U95 is against the BASELINE."
    },
    {
      "@id": "#limitation-no-experiment-anchor",
      "@type": "CreativeWork",
      "isBasedOn": "data/vv/stage17_optimization.json",
      "name": "no-experiment-anchor",
      "text": "The airfoil objective's forward model (k-omega SST, wall functions, Re 5e5) has no experiment anchor: anchors = [] in the record. Improvements are matched-condition CFD deltas, not validated absolute values."
    },
    {
      "@id": "#limitation-nogo",
      "@type": "CreativeWork",
      "isBasedOn": "data/vv/stage17_speedup.json",
      "name": "nogo",
      "text": "The pre-registered speed-up is a DEGENERATE NO-GO: the 42-solve corpus already held 5 designs past the bar, so the surrogate arm performed no marginal search."
    },
    {
      "@id": "#limitation-not-flagship-domain",
      "@type": "CreativeWork",
      "isBasedOn": "docs/adrs/ADR-046-stage-21-rescope-release-first.md",
      "name": "not-flagship-domain",
      "text": "This optimization is on the AIRFOIL case. The optimizer has never been run on a flapping-wing case. No flapping optimization claim is made in v0.1.0."
    },
    {
      "@id": "#limitation-recorded-not-re-derivable",
      "@type": "CreativeWork",
      "isBasedOn": "data/vv/stage17_optimization.json",
      "name": "recorded-not-re-derivable",
      "text": "u95_delta = 2.075 comes from 2-grid solves (s17v_base_coarse, s17v_opt_coarse) whose values and the baseline's four-tuple were not committed: recorded, not re-derivable."
    },
    {
      "@id": "#limitation-speedup-nogo",
      "@type": "CreativeWork",
      "isBasedOn": "data/vv/stage17_speedup.json",
      "name": "speedup-nogo",
      "text": "No genuine single-run acceleration is demonstrated; fall back to direct-CFD BO (S7)."
    },
    {
      "@id": "#limitation-surrogate-proposals-smoke-tier",
      "@type": "CreativeWork",
      "isBasedOn": "data/vv/stage17_arm_surrogate_explore.json",
      "name": "surrogate-proposals-smoke-tier",
      "text": "The loop's proposals came from smoke-tier, in-loop retrained ensembles, by design (ADR-032): the proposing iteration's certificate had held-out p95 8.21 and coverage 0.75. Every proposal was CFD-verified. The validated certificate is a separate fit."
    },
    {
      "@id": "#limitation-tier-capped",
      "@type": "CreativeWork",
      "isBasedOn": "data/vv/stage17_speedup.json",
      "name": "tier-capped",
      "text": "2-grid fallback GCI reached thesis-grade, but Stage-16 3-grid analysis found sub-first-order convergence (order 0.465 < 0.5); capped at validated (ADR-031/032). Thesis-grade rests on the ledgered 393^2 rung."
    },
