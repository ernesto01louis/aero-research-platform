diff -ruN a/nonlingeo_precice.c b/nonlingeo_precice.c
--- a/nonlingeo_precice.c	2026-09-15 21:45:32.757134922 +0200
+++ b/nonlingeo_precice.c	2026-09-15 21:46:53.966664329 +0200
@@ -38,6 +38,7 @@
 
 /* Adapter: Add header */
 #include "adapter/PreciceInterface.h"
+#include "adapter/AeroCheckpoint.h"
 
 #define max(a, b) ((a) >= (b) ? (a) : (b))
 
@@ -1610,6 +1611,49 @@
   /* Adapter: Give preCICE the control of the time stepping */
   // while((1.-theta>1.e-6)||(negpres==1)){
 
+  /* Adapter (aero-research-platform, ADR-045 R1): re-enter THIS step at a checkpointed
+     window boundary. The initial-acceleration procedure above ran at rest exactly as in
+     an unrestarted run, so the mass matrix, energyref and emax are the control run's;
+     everything the next window reads is now replaced by the checkpointed state, BEFORE
+     Precice_Setup registers the coupling mesh at co + vold. theta positions the step
+     time at the boundary, so the amplitude lookup (ttime + theta*tper) lands where the
+     run is, and iinc resumes the increment count. */
+  AeroCheckpointScalars aero_ckpt = {0};
+  AeroCheckpointArrays  aero_arrays;
+  aero_arrays.vold     = vold;
+  aero_arrays.veold    = veold;
+  aero_arrays.accold   = accold;
+  aero_arrays.f        = f;
+  aero_arrays.fext     = fext;
+  aero_arrays.cv       = cv;
+  aero_arrays.fnext    = fnext;
+  aero_arrays.sti      = sti;
+  aero_arrays.eme      = eme;
+  aero_arrays.ener     = ener;
+  aero_arrays.xstate   = xstate;
+  aero_arrays.n_mtnk   = mt * *nk;
+  aero_arrays.n_neq1   = neq[1];
+  aero_arrays.n_stress = (*ithermal != 2) ? 6 * mi[0] * ne0 : 0;
+  aero_arrays.n_ener   = (*nener == 1) ? mi[0] * ne0 : 0;
+  aero_arrays.n_xstate = ((*mortar != 1) && (*nstate_ != 0)) ? *nstate_ * mi[0] * (ne0 + *nslavs) : 0;
+  if (AeroCheckpoint_RestartFile() != NULL) {
+    if (*nmethod != 4 || *iexpl > 1) {
+      printf("\n *ERROR aero-checkpoint: restart is defined for implicit *DYNAMIC steps only\n\n");
+      exit(AERO_RESTART_REFUSED);
+    }
+    AeroCheckpoint_Restore(AeroCheckpoint_RestartFile(), &aero_ckpt, &aero_arrays);
+    theta  = aero_ckpt.theta;
+    iinc   = aero_ckpt.window; /* the loop's iinc++ makes the next window window + 1 */
+    qam[0] = aero_ckpt.qam0;
+    qam[1] = aero_ckpt.qam1;
+    for (k = 0; k < 4; k++) {
+      energy[k] = aero_ckpt.energy[k];
+    }
+    printf(" aero-checkpoint: re-entering the step at theta %e (after window %ld)\n", theta,
+           (long) aero_ckpt.window);
+    fflush(stdout);
+  }
+
   /* Adapter: Put all the CalculiX data that is needed for the coupling into an array */
   struct SimulationData simulationData = {
       .ialset               = ialset,
@@ -1750,6 +1794,30 @@
           }
         }
       }
+
+      /* Adapter (aero-research-platform, ADR-045 R1/R2): dump the converged end-of-window
+         state on the checkpoint cadence. iinc was incremented above, so the state is the
+         end of window iinc-1; veold/accold are still the converged values here (the
+         prediction below rewrites them), energy[] is the value the log printed for that
+         window, and the *ini copies above hold the same state. */
+      if (AeroCheckpoint_ShouldWrite(iinc - 1)) {
+        aero_ckpt.window = iinc - 1;
+        aero_ckpt.iinc   = iinc;
+        aero_ckpt.theta  = theta;
+        aero_ckpt.dtheta = dtheta;
+        aero_ckpt.ttime  = *ttime;
+        aero_ckpt.tper   = *tper;
+        aero_ckpt.qam0   = qam[0];
+        aero_ckpt.qam1   = qam[1];
+        for (k = 0; k < 4; k++) {
+          aero_ckpt.energy[k] = energy[k];
+        }
+        /* RENEW-able locals: re-read the pointers at the write. */
+        aero_arrays.vold   = vold;
+        aero_arrays.ener   = ener;
+        aero_arrays.xstate = xstate;
+        AeroCheckpoint_Write(&aero_ckpt, &aero_arrays);
+      }
     }
 
     /* check for max. # of increments */
